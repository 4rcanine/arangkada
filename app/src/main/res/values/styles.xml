<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main App Theme WITH Material Components - LIGHT MODE ONLY -->
    <style name="Theme.Arangkada" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Secondary / accent colors -->
        <item name="colorSecondary">@color/accent_color</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary_color</item>
    </style>

    <!-- Explicit NoActionBar variant (optional) -->
    <style name="Theme.Arangkada.NoActionBar" parent="Theme.Arangkada">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="TransparentDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
    </style>

    <style name="TermsHeader">
        <item name="android:textColor">#2C3E50</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="TermsBody">
        <item name="android:textColor">#555555</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

</resources>