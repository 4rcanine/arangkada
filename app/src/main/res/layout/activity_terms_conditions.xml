<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTermsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Arangkada Terms &amp; Conditions"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E3A8A"
            android:gravity="center"
            android:layout_marginBottom="12dp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:clipToOutline="true">

            <!-- Introduction -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome to Arangkada — your trusted UV Express carpooling app. By using this application, you agree to the following Terms and Conditions:"
                android:textColor="#333333"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="6dp" />

            <!-- ============================== -->
            <!-- FULL TERMS AND CONDITIONS TEXT -->
            <!-- ============================== -->

            <!-- Section 1 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Definition of Terms"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="“App” or “Arangkada” – refers to the Arangkada mobile application operated by the Arangkada team.\n\n“User” – refers to any individual who registers, creates a profile, and books rides through the app.\n\n“Admin” – refers to authorized drivers or operators who manage bookings and ride schedules through a separate admin account (e.g., ending in @admin.com).\n\n“Service” – refers to the carpooling and ride-booking features provided by the app.\n\n“Booking” – refers to a confirmed ride request made through the app.\n\n“Payment” – refers to the exchange of fare made in cash or via GCash." />

            <!-- Section 2 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Eligibility"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="• Users must be at least 18 years old to create an account and use the app.\n• Users agree to provide accurate, current, and complete information when registering.\n• The app reserves the right to suspend or terminate accounts found to contain false or misleading information." />

            <!-- Section 3 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. User Accounts"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="• Each user must create an account to access booking features.\n• Users are responsible for maintaining the confidentiality of their login credentials.\n• The app is not responsible for any unauthorized use of an account.\n• Admin accounts are exclusively for verified drivers and operators; regular users are not allowed to access admin credentials." />

            <!-- Section 4 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Booking and Ride Policies"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="• Users can book rides between Cervantes and Baguio City only.\n• Ride schedules, seat availability, and fares are managed by the admin.\n• Users must arrive on time at the agreed pickup point.\n• Cancellations should be made at least 30 minutes before departure.\n• No-shows may lead to temporary suspension of booking privileges.\n• Arangkada acts as a booking facilitator and does not directly operate transportation vehicles." />

            <!-- Section 5 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. Privacy and Data Use"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="• The app collects user data (e.g., name, email, contact number) solely for service facilitation.\n• User data will not be sold or shared with third parties without consent.\n• By using the app, users agree to the processing of their personal data in accordance with the Philippine Data Privacy Act of 2012." />

            <!-- Section 6 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6. Payment Terms"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="• Payments are made either in cash or through GCash at the terminal.\n• Arangkada does not handle or store payment information directly.\n• Users are required to confirm payment upon booking confirmation." />

            <!-- Section 7 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="7. Limitations of Liability"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="• Arangkada is not responsible for delays, cancellations, or damages caused by third-party operators.\n• The app serves only as a booking platform and is not a transportation company.\n• Any disputes related to fare or service quality should be addressed directly with the van operator." />

            <!-- Section 8 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="8. Account Termination"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="• Users may delete their account anytime.\n• The app reserves the right to suspend or terminate accounts for misuse, fraudulent activity, or violation of these terms." />

            <!-- Section 9 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="9. Notifications"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="• The app may send notifications for booking updates, seat availability, or promotions.\n• Users can enable or disable notifications anytime in the app settings." />

            <!-- Section 10 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="10. Amendments"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="• These Terms and Conditions may be updated from time to time.\n• Continued use of the app after updates constitutes acceptance of the new terms." />

            <!-- Section 11 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="11. Contact Information"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="For questions or feedback regarding these Terms and Conditions, you may contact us at support@arangkada.com." />

            <!-- Section 12 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="12. Governing Law"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="These Terms and Conditions shall be governed by and construed in accordance with the laws of the Republic of the Philippines. Any disputes shall be resolved in the proper courts of Benguet Province." />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
