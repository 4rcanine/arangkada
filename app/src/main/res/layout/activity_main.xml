<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Main content area -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_primary">

        <!-- Modern Navigation Bar with Gradient -->
        <LinearLayout
            android:id="@+id/navigation_container"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/auth_gradient_background"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:elevation="8dp">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/white"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

            <!-- Title Space -->
            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dashboard"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:layout_marginStart="16dp"
                android:gravity="start|center_vertical" />

            <!-- Menu Button -->
            <ImageView
                android:id="@+id/btn_menu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_menu"
                android:tint="@color/white"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/navigation_container">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/background_primary"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Modern Header Section with Floating Card Design -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- Gradient Background -->
                        <View
                            android:id="@+id/header_background"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:background="@drawable/auth_gradient_background" />

                        <!-- Floating Welcome Card -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            android:layout_marginTop="20dp"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="16dp"
                            app:cardMaxElevation="20dp"
                            android:backgroundTint="#F5F5F5">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="24dp"
                                android:gravity="center_vertical">

                                <!-- Welcome Text -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tv_welcome"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Welcome back,"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="14sp"
                                        android:letterSpacing="0.03" />

                                    <TextView
                                        android:id="@+id/tv_user_name"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Loading..."
                                        android:textColor="@color/text_primary"
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:letterSpacing="-0.01"
                                        android:layout_marginTop="4dp" />

                                </LinearLayout>

                                <!-- Notification Icon in Circle -->
                                <RelativeLayout
                                    android:layout_width="56dp"
                                    android:layout_height="56dp">

                                    <View
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:background="@drawable/notification_badge"
                                        android:backgroundTint="@color/primary_color"
                                        android:alpha="0.1" />

                                    <ImageView
                                        android:id="@+id/iv_notifications"
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:layout_centerInParent="true"
                                        android:src="@drawable/ic_notifications"
                                        android:tint="@color/primary_color"
                                        android:background="?android:attr/selectableItemBackgroundBorderless"
                                        android:padding="2dp" />

                                    <ImageView
                                        android:id="@+id/iv_notification_badge"
                                        android:layout_width="10dp"
                                        android:layout_height="10dp"
                                        android:layout_alignTop="@id/iv_notifications"
                                        android:layout_alignEnd="@id/iv_notifications"
                                        android:layout_marginTop="2dp"
                                        android:layout_marginEnd="2dp"
                                        android:background="@drawable/notification_badge"
                                        android:backgroundTint="#FF4444"
                                        android:visibility="gone" />

                                </RelativeLayout>

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </RelativeLayout>

                    <!-- Your Trips Section - Modern Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="28dp"
                        android:paddingBottom="12dp">

                        <!-- Section Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="24dp"
                                android:background="@color/primary_color"
                                android:layout_marginEnd="12dp" />

                            <TextView
                                android:id="@+id/tv_trip_section_title"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Your Trips"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:letterSpacing="-0.01" />

                        </LinearLayout>

                        <!-- Trip Info Card - Enhanced Design -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_trip_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="12dp"
                            app:cardMaxElevation="16dp"
                            android:backgroundTint="#F5F5F5">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="24dp">

                                <!-- Trip Header with Status -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="16dp">

                                    <TextView
                                        android:id="@+id/tv_next_trip_title"
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:layout_height="wrap_content"
                                        android:text="Upcoming Trip"
                                        android:textSize="13sp"
                                        android:textColor="@color/text_secondary"
                                        android:textStyle="bold"
                                        android:textAllCaps="true"
                                        android:letterSpacing="0.08" />

                                    <!-- Status Chip -->
                                    <TextView
                                        android:id="@+id/tv_trip_status"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingHorizontal="16dp"
                                        android:paddingVertical="8dp"
                                        android:text="Confirmed"
                                        android:textColor="@android:color/white"
                                        android:textStyle="bold"
                                        android:textSize="11sp"
                                        android:background="@drawable/bg_status_confirmed"
                                        android:visibility="gone"
                                        android:elevation="2dp" />

                                </LinearLayout>

                                <!-- Destination with Icon -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="12dp">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_route"
                                        android:tint="@color/primary_color"
                                        android:layout_marginEnd="12dp" />

                                    <TextView
                                        android:id="@+id/tv_next_trip_route"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Loading trip..."
                                        android:textSize="20sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_primary"
                                        android:letterSpacing="-0.01" />

                                </LinearLayout>

                                <!-- Date & Time -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="8dp">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:src="@drawable/ic_history"
                                        android:tint="@color/text_secondary"
                                        android:layout_marginEnd="10dp" />

                                    <TextView
                                        android:id="@+id/tv_next_trip_date"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=""
                                        android:textSize="14sp"
                                        android:textColor="@color/text_secondary" />

                                </LinearLayout>

                                <!-- Total Fare -->
                                <TextView
                                    android:id="@+id/tv_total_fare"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textSize="14sp"
                                    android:textColor="@color/text_secondary"
                                    android:layout_marginTop="4dp"
                                    android:visibility="gone" />

                                <!-- View QR Button - Modern Style -->
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_view_qr"
                                    android:layout_width="match_parent"
                                    android:layout_height="56dp"
                                    android:text="View QR Code"
                                    android:textAllCaps="false"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    android:visibility="gone"
                                    app:icon="@drawable/ic_qr"
                                    app:iconGravity="textStart"
                                    app:iconPadding="12dp"
                                    app:iconSize="24dp"
                                    app:cornerRadius="16dp"
                                    app:elevation="6dp"
                                    app:backgroundTint="@color/teal_700"
                                    android:textColor="@android:color/white"
                                    android:letterSpacing="0.02"
                                    android:stateListAnimator="@null" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <!-- Main Features Grid - Enhanced Cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="24dp">

                        <!-- Section Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="24dp"
                                android:background="@color/primary_color"
                                android:layout_marginEnd="12dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quick Actions"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:letterSpacing="-0.01" />

                        </LinearLayout>

                        <!-- First Row - Modern Cards -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2"
                            android:layout_marginBottom="16dp">

                            <!-- Book Ride Card -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/card_book_ride"
                                android:layout_width="0dp"
                                android:layout_height="140dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="10dp"
                                app:cardMaxElevation="14dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground"
                                android:backgroundTint="#F5F5F5">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:padding="20dp">

                                    <!-- Icon in Circle Background -->
                                    <RelativeLayout
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:layout_marginBottom="12dp">

                                        <View
                                            android:layout_width="56dp"
                                            android:layout_height="56dp"
                                            android:background="@drawable/notification_badge"
                                            android:backgroundTint="@color/primary_color"
                                            android:alpha="0.15" />

                                        <ImageView
                                            android:layout_width="28dp"
                                            android:layout_height="28dp"
                                            android:layout_centerInParent="true"
                                            android:src="@drawable/ic_route"
                                            android:tint="@color/primary_color" />

                                    </RelativeLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Book Ride"
                                        android:textSize="17sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_primary"
                                        android:gravity="center"
                                        android:layout_marginBottom="4dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Find and book"
                                        android:textSize="12sp"
                                        android:textColor="@color/text_secondary"
                                        android:gravity="center" />

                                </LinearLayout>

                            </androidx.cardview.widget.CardView>

                            <!-- My Trips Card -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/card_my_trips"
                                android:layout_width="0dp"
                                android:layout_height="140dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="10dp"
                                app:cardMaxElevation="14dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground"
                                android:backgroundTint="#F5F5F5">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:padding="20dp">

                                    <!-- Icon in Circle Background -->
                                    <RelativeLayout
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:layout_marginBottom="12dp">

                                        <View
                                            android:layout_width="56dp"
                                            android:layout_height="56dp"
                                            android:background="@drawable/notification_badge"
                                            android:backgroundTint="@color/primary_color"
                                            android:alpha="0.15" />

                                        <ImageView
                                            android:layout_width="28dp"
                                            android:layout_height="28dp"
                                            android:layout_centerInParent="true"
                                            android:src="@drawable/ic_history"
                                            android:tint="@color/primary_color" />

                                    </RelativeLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="My Trips"
                                        android:textSize="17sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_primary"
                                        android:gravity="center"
                                        android:layout_marginBottom="4dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="View bookings"
                                        android:textSize="12sp"
                                        android:textColor="@color/text_secondary"
                                        android:gravity="center" />

                                </LinearLayout>

                            </androidx.cardview.widget.CardView>

                        </LinearLayout>

                        <!-- Second Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <!-- Notifications Card -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/card_notifications"
                                android:layout_width="0dp"
                                android:layout_height="140dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="10dp"
                                app:cardMaxElevation="14dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground"
                                android:backgroundTint="#F5F5F5">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:padding="20dp">

                                    <!-- Icon in Circle Background -->
                                    <RelativeLayout
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:layout_marginBottom="12dp">

                                        <View
                                            android:layout_width="56dp"
                                            android:layout_height="56dp"
                                            android:background="@drawable/notification_badge"
                                            android:backgroundTint="@color/primary_color"
                                            android:alpha="0.15" />

                                        <ImageView
                                            android:layout_width="28dp"
                                            android:layout_height="28dp"
                                            android:layout_centerInParent="true"
                                            android:src="@drawable/ic_notifications"
                                            android:tint="@color/primary_color" />

                                    </RelativeLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Notifications"
                                        android:textSize="17sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_primary"
                                        android:gravity="center"
                                        android:layout_marginBottom="4dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Updates"
                                        android:textSize="12sp"
                                        android:textColor="@color/text_secondary"
                                        android:gravity="center" />

                                </LinearLayout>

                            </androidx.cardview.widget.CardView>

                            <!-- Profile Card -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/card_profile"
                                android:layout_width="0dp"
                                android:layout_height="140dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="10dp"
                                app:cardMaxElevation="14dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground"
                                android:backgroundTint="#F5F5F5">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:padding="20dp">

                                    <!-- Icon in Circle Background -->
                                    <RelativeLayout
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:layout_marginBottom="12dp">

                                        <View
                                            android:layout_width="56dp"
                                            android:layout_height="56dp"
                                            android:background="@drawable/notification_badge"
                                            android:backgroundTint="@color/primary_color"
                                            android:alpha="0.15" />

                                        <ImageView
                                            android:layout_width="28dp"
                                            android:layout_height="28dp"
                                            android:layout_centerInParent="true"
                                            android:src="@drawable/ic_profile"
                                            android:tint="@color/primary_color" />

                                    </RelativeLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Profile"
                                        android:textSize="17sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_primary"
                                        android:gravity="center"
                                        android:layout_marginBottom="4dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Account"
                                        android:textSize="12sp"
                                        android:textColor="@color/text_secondary"
                                        android:gravity="center" />

                                </LinearLayout>

                            </androidx.cardview.widget.CardView>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Spacer for better scrolling -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="32dp" />

                </LinearLayout>

            </ScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </RelativeLayout>

    <!-- Right-side Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header_main"
        app:menu="@menu/activity_main_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>